{
  "Mail2Go": {
    "ApplicationName": "Mail2Go",
    "AllowUnknownDomains": true,
    "AllowUnknownRecipients": true,
    "RequirePasswordChangeForSeedUsers": true
  },
  "Smtp": {
    "Host": "0.0.0.0",
    "Port": 2525,
    "EnableTls": false,
    "RequireAuthentication": true,
    "AllowAnonymous": false,
    "MaxMessageSizeBytes": 10485760
  },
  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=data/mail2go.db"
  },
  "Storage": {
    "RootPath": "data",
    "AttachmentPath": "data/attachments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
