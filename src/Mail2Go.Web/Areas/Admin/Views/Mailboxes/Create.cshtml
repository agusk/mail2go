@model Mail2Go.Web.ViewModels.Admin.CreateMailboxViewModel
@{
    ViewData["Title"] = "Add Mailbox";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Add Mailbox</h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">? Back</a>
</div>

<div class="card" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size:0.85rem" role="alert"></div>
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label">Display Name</label>
                <input asp-for="DisplayName" class="form-control" placeholder="John Doe" autofocus />
                <span asp-validation-for="DisplayName" class="text-danger" style="font-size:0.8rem"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="johndoe" />
                <span asp-validation-for="Username" class="text-danger" style="font-size:0.8rem"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <div class="input-group">
                    <input asp-for="LocalPart" class="form-control" placeholder="username" style="max-width:200px" />
                    <span class="input-group-text">@@</span>
                    <select asp-for="DomainId" class="form-select">
                        <option value="">-- Select Domain --</option>
                        @foreach (var domain in Model.Domains)
                        {
                            <option value="@domain.Id">@domain.Name</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="LocalPart" class="text-danger" style="font-size:0.8rem"></span>
                <span asp-validation-for="DomainId" class="text-danger" style="font-size:0.8rem"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Min. 6 characters" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Mailbox</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
