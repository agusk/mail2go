@model IReadOnlyList<Mail2Go.Domain.Mailboxes.Mailbox>
@{
    ViewData["Title"] = "Mailboxes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mailboxes</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Mailbox</a>
</div>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Address</th>
            <th>Status</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mb in Model)
        {
            <tr>
                <td>@mb.Address</td>
                <td>
                    @if (mb.IsEnabled)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Disabled</span>
                    }
                </td>
                <td>@mb.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
