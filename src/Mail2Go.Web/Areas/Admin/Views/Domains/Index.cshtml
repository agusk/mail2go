@model IReadOnlyList<Mail2Go.Domain.Domains.MailDomain>
@{
    ViewData["Title"] = "Domains";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Domains</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Domain</a>
</div>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var domain in Model)
        {
            <tr>
                <td><strong>@domain.Name</strong></td>
                <td>
                    @if (domain.IsEnabled)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Disabled</span>
                    }
                </td>
                <td>@domain.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <form asp-action="Toggle" asp-route-id="@domain.Id" method="post" class="d-inline">
                        @if (domain.IsEnabled)
                        {
                            <button type="submit" class="btn btn-sm btn-warning">Disable</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-success">Enable</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
