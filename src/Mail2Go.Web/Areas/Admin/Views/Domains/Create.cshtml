@{
    ViewData["Title"] = "Add Domain";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Add Domain</h1>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">? Back</a>
</div>

<div class="card" style="max-width:480px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Domain Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="example.com" required autofocus />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add Domain</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
