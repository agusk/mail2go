<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mail2Go</title>
    <link rel="icon" type="image/svg+xml" href="/images/mail2go.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Apply saved theme before render to avoid flash
        (function () {
            var t = localStorage.getItem("mail2go-theme") || "dark";
            document.documentElement.setAttribute("data-bs-theme", t);
        })();
    </script>
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- ===== TOP BAR ===== -->
    <header class="topbar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="/images/mail2go.svg" alt="Mail2Go" />
            Mail2Go
        </a>
        <div class="topbar-right">
            <span class="topbar-user d-none d-md-inline">@User.Identity.Name</span>
            <button class="theme-toggle" id="themeToggle" title="Toggle theme">
                <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                    <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
                <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
            </button>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
            </form>
        </div>
    </header>

    <!-- ===== APP WRAPPER ===== -->
    <div class="app-wrapper">
        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar">
            @if (User.IsInRole("Admin"))
            {
                <div class="sidebar-section-label">Admin</div>
                <ul class="sidebar-nav">
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Domains" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            Domains
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Mailboxes" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            Mailboxes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Messages" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            All Messages
                        </a>
                    </li>
                </ul>
            }
            else
            {
                <div class="sidebar-section-label">Mailbox</div>
                <ul class="sidebar-nav">
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Mailbox" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                            Inbox
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Mailbox" asp-action="Compose">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            Compose
                        </a>
                    </li>
                </ul>
            }
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        var btn = document.getElementById("themeToggle");
        if (!btn) return;
        var html = document.documentElement;
        var iconSun = document.getElementById("iconSun");
        var iconMoon = document.getElementById("iconMoon");

        function applyTheme(t) {
            html.setAttribute("data-bs-theme", t);
            localStorage.setItem("mail2go-theme", t);
            if (t === "dark") {
                iconSun.style.display = "block";
                iconMoon.style.display = "none";
            } else {
                iconSun.style.display = "none";
                iconMoon.style.display = "block";
            }
        }

        // init
        applyTheme(localStorage.getItem("mail2go-theme") || "dark");

        btn.addEventListener("click", function () {
            var current = html.getAttribute("data-bs-theme");
            applyTheme(current === "dark" ? "light" : "dark");
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
